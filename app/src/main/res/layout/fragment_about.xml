<?xml version="1.0" encoding="utf-8"?>
<!-- CollapsingToolbar trong trang — title di cung noi dung khi vuot ngang -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainer">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/about_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        app:elevation="0dp"
        app:liftOnScroll="true">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/about_collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/updater_collapsing_toolbar_height"
            app:collapsedTitleTextAppearance="@style/TextAppearance.Updater.CollapsingToolbar.Collapsed"
            app:expandedTitleMarginBottom="@dimen/expanded_title_margin_bottom"
            app:expandedTitleMarginEnd="@dimen/expanded_title_margin_end"
            app:expandedTitleMarginStart="@dimen/expanded_title_margin_start"
            app:expandedTitleTextAppearance="@style/TextAppearance.Updater.CollapsingToolbar.Expanded"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:scrimVisibleHeightTrigger="@dimen/settingslib_scrim_visible_height_trigger"
            app:titleCollapseMode="fade"
            app:title="@string/nav_tab_about">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/about_toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:layout_collapseMode="pin"
                app:title=""
                app:titleTextAppearance="?attr/textAppearanceTitleLarge" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- NestedScroll: chi fade canh tren; day dung overlay activity -->
    <org.evolution.updater.ui.TopFadingNestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurfaceContainer"
        android:clipToPadding="false"
        android:fadingEdgeLength="48dp"
        android:fillViewport="true"
        android:overScrollMode="always"
        android:paddingBottom="@dimen/updater_scroll_padding_bottom"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <!-- Updater app -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="24dp"
                android:paddingTop="8dp"
                android:paddingEnd="24dp"
                android:paddingBottom="4dp"
                android:text="@string/about_app_card_title"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorPrimary" />

            <!-- The don: icon + title + summary version (dong bo language row / Support) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/updater_preference_card_margin_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="@dimen/updater_preference_card_margin_horizontal"
                android:background="@drawable/updater_preference_bg_single"
                android:gravity="center_vertical"
                android:minHeight="@dimen/updater_preference_row_min_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/updater_preference_row_padding_start"
                android:paddingEnd="@dimen/updater_preference_row_padding_end">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="@dimen/updater_preference_icon_margin_end"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_app_version"
                    app:tint="?attr/colorOnSurface" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/updater_preference_row_padding_vertical"
                    android:paddingBottom="@dimen/updater_preference_row_padding_vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/about_app_version_title"
                        android:textAppearance="?android:attr/textAppearanceListItem"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/about_app_version"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="?android:attr/textAppearanceListItemSecondary"
                        android:textColor="?android:attr/textColorSecondary"
                        tools:text="1.1" />
                </LinearLayout>
            </LinearLayout>

            <!-- Ho tro: Telegram / GitHub / Maintainer -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="24dp"
                android:paddingTop="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="4dp"
                android:text="@string/about_support"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorPrimary" />

            <!-- Nhom Expressive: bg drawable nhu SettingsLib (khong MaterialCardView — Card.Top bi phinh cao). -->
            <LinearLayout
                android:id="@+id/support_forum_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/updater_preference_card_margin_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="@dimen/updater_preference_card_margin_horizontal"
                android:background="@drawable/updater_preference_bg_top"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/support_forum"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/updater_preference_row_min_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/updater_preference_row_padding_start"
                    android:paddingEnd="@dimen/updater_preference_row_padding_end">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="@dimen/updater_preference_icon_margin_end"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_forum"
                        app:tint="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingTop="@dimen/updater_preference_row_padding_vertical"
                        android:paddingBottom="@dimen/updater_preference_row_padding_vertical"
                        android:text="@string/support_telegram"
                        android:textAppearance="?android:attr/textAppearanceListItem"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/support_source_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/updater_preference_card_margin_horizontal"
                android:layout_marginTop="@dimen/updater_preference_card_gap"
                android:layout_marginEnd="@dimen/updater_preference_card_margin_horizontal"
                android:background="@drawable/updater_preference_bg_center"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/support_source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/updater_preference_row_min_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/updater_preference_row_padding_start"
                    android:paddingEnd="@dimen/updater_preference_row_padding_end">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="@dimen/updater_preference_icon_margin_end"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_github"
                        app:tint="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingTop="@dimen/updater_preference_row_padding_vertical"
                        android:paddingBottom="@dimen/updater_preference_row_padding_vertical"
                        android:text="@string/support_github"
                        android:textAppearance="?android:attr/textAppearanceListItem"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/updater_preference_card_margin_horizontal"
                android:layout_marginTop="@dimen/updater_preference_card_gap"
                android:layout_marginEnd="@dimen/updater_preference_card_margin_horizontal"
                android:background="@drawable/updater_preference_bg_bottom"
                android:gravity="center_vertical"
                android:minHeight="@dimen/updater_preference_row_min_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/updater_preference_row_padding_start"
                android:paddingEnd="@dimen/updater_preference_row_padding_end">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="@dimen/updater_preference_icon_margin_end"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_maintainer"
                    app:tint="?attr/colorOnSurface" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/updater_preference_row_padding_vertical"
                    android:paddingBottom="@dimen/updater_preference_row_padding_vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/about_maintainer_subtitle"
                        android:textAppearance="?android:attr/textAppearanceListItem"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/about_maintainer_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/default_maintainer_name"
                        android:textAppearance="?android:attr/textAppearanceListItemSecondary"
                        android:textColor="?android:attr/textColorSecondary" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </org.evolution.updater.ui.TopFadingNestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
