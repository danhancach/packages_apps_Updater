<?xml version="1.0" encoding="utf-8"?>
<!-- CollapsingToolbar trong trang — title/banner di cung noi dung khi vuot ngang -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainer">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/home_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        android:clipChildren="false"
        app:elevation="0dp"
        app:liftOnScroll="true">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/home_collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/updater_collapsing_toolbar_height"
            android:clipChildren="false"
            app:collapsedTitleTextAppearance="@style/TextAppearance.Updater.CollapsingToolbar.Collapsed"
            app:expandedTitleMarginBottom="@dimen/expanded_title_margin_bottom"
            app:expandedTitleMarginEnd="@dimen/expanded_title_margin_end"
            app:expandedTitleMarginStart="@dimen/expanded_title_margin_start"
            app:expandedTitleTextAppearance="@style/TextAppearance.Updater.CollapsingToolbar.Expanded"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:scrimVisibleHeightTrigger="@dimen/settingslib_scrim_visible_height_trigger"
            app:titleCollapseMode="fade"
            app:title="">

            <!-- Banner Evolution — expanded; collapsed hien nav_tab_home -->
            <FrameLayout
                android:id="@+id/home_brand_header"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="16dp"
                app:layout_collapseMode="parallax">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_gravity="bottom|start"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/brand_evolution_x"
                    android:scaleType="fitStart"
                    android:src="@drawable/ic_evolution_logo" />
            </FrameLayout>

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/home_toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:layout_collapseMode="pin"
                app:navigationIconTint="?attr/colorOnSurface"
                app:title=""
                app:titleTextAppearance="?attr/textAppearanceTitleLarge" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Keo xuong de lam moi; NestedScroll + edge fade / overscroll -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/home_swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <org.evolution.updater.ui.TopFadingNestedScrollView
            android:id="@+id/home_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorSurfaceContainer"
            android:clipToPadding="false"
            android:fadingEdgeLength="48dp"
            android:fillViewport="true"
            android:overScrollMode="always"
            android:paddingBottom="@dimen/updater_scroll_padding_bottom"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp">

                <!-- The 1: trang thai trong the (khong tach tieu de) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/home_status_card"
                    style="@style/Widget.Updater.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="16dp"
                    app:contentPadding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/home_status_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_status_up_to_date"
                            android:textAppearance="?attr/textAppearanceHeadlineSmall"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="Up to date" />

                        <TextView
                            android:id="@+id/header_build_version"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="Evolution X 12.2" />

                        <TextView
                            android:id="@+id/header_android_version"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="Android 17" />

                        <TextView
                            android:id="@+id/header_kernel_version"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="Kernel 5.15.xxx" />

                        <TextView
                            android:id="@+id/header_build_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="Build date: 29 September 2026" />

                        <TextView
                            android:id="@+id/header_last_check"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="Last checked" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="24dp"
                    android:paddingTop="24dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="4dp"
                    android:text="@string/cloud_update_title"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorPrimary" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/home_cloud_update_card"
                    style="@style/Widget.Updater.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="16dp"
                    app:contentPadding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/home_cloud_empty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:alpha="0.6"
                            android:text="@string/home_no_updates_available"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recycler_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipToPadding="false"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never"
                            android:visibility="gone"
                            tools:itemCount="1"
                            tools:listitem="@layout/update_item_embedded"
                            tools:visibility="visible" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Tieu de section local (khong IconButton) -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="24dp"
                    android:paddingTop="24dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="4dp"
                    android:text="@string/local_update_import"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorPrimary" />

                <!-- Local: nhom the Top (empty/list) + Bottom (import), gap 2dp -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/home_local_update_card"
                    style="@style/Widget.Updater.PreferenceCard.Top"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/updater_preference_card_margin_horizontal"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="@dimen/updater_preference_card_margin_horizontal"
                    app:contentPadding="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Root row: minHeight 72, pad ngang 16, khong pad doc -->
                        <TextView
                            android:id="@+id/home_local_empty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:alpha="0.6"
                            android:gravity="center_vertical"
                            android:minHeight="@dimen/updater_preference_row_min_height"
                            android:paddingStart="@dimen/updater_preference_row_padding_start"
                            android:paddingEnd="@dimen/updater_preference_row_padding_end"
                            android:text="@string/home_no_updates_available"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/local_recycler_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipToPadding="false"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never"
                            android:paddingStart="@dimen/updater_preference_row_padding_start"
                            android:paddingEnd="@dimen/updater_preference_row_padding_end"
                            android:visibility="gone"
                            tools:itemCount="1"
                            tools:listitem="@layout/update_item_embedded"
                            tools:visibility="visible" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Them ban cap nhat: the Bottom, chi title, khong summary -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Updater.PreferenceCard.Bottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/updater_preference_card_margin_horizontal"
                    android:layout_marginTop="@dimen/updater_preference_card_gap"
                    android:layout_marginEnd="@dimen/updater_preference_card_margin_horizontal"
                    app:contentPadding="0dp">

                    <LinearLayout
                        android:id="@+id/home_import_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/updater_preference_row_min_height"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/updater_preference_row_padding_start"
                        android:paddingEnd="@dimen/updater_preference_row_padding_end">

                        <FrameLayout
                            android:layout_width="@dimen/updater_preference_icon_size"
                            android:layout_height="@dimen/updater_preference_icon_size"
                            android:layout_marginEnd="@dimen/updater_preference_icon_margin_end">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:contentDescription="@string/home_add_update"
                                android:src="@drawable/ic_add"
                                app:tint="?android:attr/colorControlNormal" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:text="@string/home_add_update"
                            android:textAppearance="?android:attr/textAppearanceListItem"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </org.evolution.updater.ui.TopFadingNestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
