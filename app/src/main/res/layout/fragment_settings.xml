<?xml version="1.0" encoding="utf-8"?>
<!-- CollapsingToolbar trong trang — title di cung noi dung khi vuot ngang -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainer">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/settings_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        app:elevation="0dp"
        app:liftOnScroll="true">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/settings_collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/updater_collapsing_toolbar_height"
            app:collapsedTitleTextAppearance="@style/TextAppearance.Updater.CollapsingToolbar.Collapsed"
            app:expandedTitleMarginBottom="@dimen/expanded_title_margin_bottom"
            app:expandedTitleMarginEnd="@dimen/expanded_title_margin_end"
            app:expandedTitleMarginStart="@dimen/expanded_title_margin_start"
            app:expandedTitleTextAppearance="@style/TextAppearance.Updater.CollapsingToolbar.Expanded"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:scrimVisibleHeightTrigger="@dimen/settingslib_scrim_visible_height_trigger"
            app:titleCollapseMode="fade"
            app:title="@string/nav_tab_settings">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/settings_toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:layout_collapseMode="pin"
                app:title=""
                app:titleTextAppearance="?attr/textAppearanceTitleLarge" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- NestedScroll: chi fade canh tren; day dung overlay activity -->
    <org.evolution.updater.ui.TopFadingNestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurfaceContainer"
        android:clipToPadding="false"
        android:fadingEdgeLength="48dp"
        android:fillViewport="true"
        android:overScrollMode="always"
        android:paddingBottom="@dimen/updater_scroll_padding_bottom"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <!-- Ngon ngu: hang jump ReSukiSU (khong category rieng, khong Spinner) -->
            <LinearLayout
                android:id="@+id/settings_language_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/updater_preference_card_margin_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="@dimen/updater_preference_card_margin_horizontal"
                android:background="@drawable/updater_preference_bg_single"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="@dimen/updater_preference_row_min_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/updater_preference_row_padding_start"
                android:paddingEnd="@dimen/updater_preference_row_padding_end">

                <!-- ReSukiSU: leading Box 24dp, tint colorOnSurface (khong frame 40dp) -->
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="@dimen/updater_preference_icon_margin_end"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_translate"
                    app:tint="?attr/colorOnSurface" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/updater_preference_row_padding_vertical"
                    android:paddingEnd="16dp"
                    android:paddingBottom="@dimen/updater_preference_row_padding_vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_language"
                        android:textAppearance="?android:attr/textAppearanceListItem"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/settings_language_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="?android:attr/textAppearanceListItemSecondary"
                        android:textColor="?android:attr/textColorSecondary" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_expand_chevron"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="24dp"
                android:paddingTop="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="4dp"
                android:text="@string/menu_auto_updates_check"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorPrimary" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Updater.PreferenceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/updater_preference_card_margin_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="@dimen/updater_preference_card_margin_horizontal"
                app:contentPadding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="4dp"
                        android:text="@string/menu_auto_updates_check"
                        android:textAppearance="?android:attr/textAppearanceListItem"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="16dp"
                        android:text="@string/settings_summary_auto_check"
                        android:textAppearance="?android:attr/textAppearanceListItemSecondary"
                        android:textColor="?android:attr/textColorSecondary" />

                    <!-- Spinner pill — pattern BatteryMonitor -->
                    <Spinner
                        android:id="@+id/auto_check_interval_spinner"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:minWidth="200dp"
                        android:background="@drawable/updater_spinner_pill"
                        android:paddingStart="4dp"
                        android:paddingEnd="28dp"
                        android:popupBackground="@drawable/updater_spinner_popup_bg"
                        android:spinnerMode="dropdown" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Behavior: moi preference = 1 the (Settings Expressive state_single) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="24dp"
                android:paddingTop="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="4dp"
                android:text="@string/settings_section_behavior"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorPrimary" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/preferences_auto_delete_card"
                style="@style/Widget.Updater.PreferenceCard.Top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/updater_preference_card_margin_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="@dimen/updater_preference_card_margin_horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/updater_preference_row_min_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/updater_preference_row_padding_start"
                    android:paddingTop="@dimen/updater_preference_row_padding_vertical"
                    android:paddingEnd="@dimen/updater_preference_row_padding_end"
                    android:paddingBottom="@dimen/updater_preference_row_padding_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingEnd="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/menu_auto_delete_updates"
                            android:textAppearance="?android:attr/textAppearanceListItem"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/settings_summary_auto_delete"
                            android:textAppearance="?android:attr/textAppearanceListItemSecondary"
                            android:textColor="?android:attr/textColorSecondary" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/preferences_auto_delete_updates"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="48dp"
                        android:minHeight="48dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/preferences_metered_network_card"
                style="@style/Widget.Updater.PreferenceCard.Center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/updater_preference_card_margin_horizontal"
                android:layout_marginTop="@dimen/updater_preference_card_gap"
                android:layout_marginEnd="@dimen/updater_preference_card_margin_horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/updater_preference_row_min_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/updater_preference_row_padding_start"
                    android:paddingTop="@dimen/updater_preference_row_padding_vertical"
                    android:paddingEnd="@dimen/updater_preference_row_padding_end"
                    android:paddingBottom="@dimen/updater_preference_row_padding_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingEnd="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/menu_metered_network_warning"
                            android:textAppearance="?android:attr/textAppearanceListItem"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/settings_summary_metered_network"
                            android:textAppearance="?android:attr/textAppearanceListItemSecondary"
                            android:textColor="?android:attr/textColorSecondary" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/preferences_metered_network_warning"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="48dp"
                        android:minHeight="48dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/preferences_ab_perf_mode_card"
                style="@style/Widget.Updater.PreferenceCard.Center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/updater_preference_card_margin_horizontal"
                android:layout_marginTop="@dimen/updater_preference_card_gap"
                android:layout_marginEnd="@dimen/updater_preference_card_margin_horizontal">

                <LinearLayout
                    android:id="@+id/preferences_ab_perf_mode_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/updater_preference_row_min_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/updater_preference_row_padding_start"
                    android:paddingTop="@dimen/updater_preference_row_padding_vertical"
                    android:paddingEnd="@dimen/updater_preference_row_padding_end"
                    android:paddingBottom="@dimen/updater_preference_row_padding_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingEnd="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/menu_ab_perf_mode"
                            android:textAppearance="?android:attr/textAppearanceListItem"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/settings_summary_ab_perf_mode"
                            android:textAppearance="?android:attr/textAppearanceListItemSecondary"
                            android:textColor="?android:attr/textColorSecondary" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/preferences_ab_perf_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="48dp"
                        android:minHeight="48dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/preferences_update_recovery_card"
                style="@style/Widget.Updater.PreferenceCard.Bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/updater_preference_card_margin_horizontal"
                android:layout_marginTop="@dimen/updater_preference_card_gap"
                android:layout_marginEnd="@dimen/updater_preference_card_margin_horizontal">

                <LinearLayout
                    android:id="@+id/preferences_update_recovery_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/updater_preference_row_min_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/updater_preference_row_padding_start"
                    android:paddingTop="@dimen/updater_preference_row_padding_vertical"
                    android:paddingEnd="@dimen/updater_preference_row_padding_end"
                    android:paddingBottom="@dimen/updater_preference_row_padding_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingEnd="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/menu_update_recovery"
                            android:textAppearance="?android:attr/textAppearanceListItem"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/settings_summary_update_recovery"
                            android:textAppearance="?android:attr/textAppearanceListItemSecondary"
                            android:textColor="?android:attr/textColorSecondary" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/preferences_update_recovery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="48dp"
                        android:minHeight="48dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </org.evolution.updater.ui.TopFadingNestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
