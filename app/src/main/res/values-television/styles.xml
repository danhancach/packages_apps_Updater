<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- TV: parent DayNight (AppCompat), KHONG dung *.NoActionBar stock (mat parent) -->
    <style name="AppTheme" parent="Theme.Material3.DayNight">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/tv_background</item>
        <item name="alertDialogTheme">@style/AppTheme.AlertDialogTheme</item>
        <item name="materialAlertDialogTheme">@style/AppTheme.AlertDialogTheme</item>
        <item name="popupMenuStyle">@style/Widget.Material3.PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/Widget.Material3.PopupMenu.Overflow</item>
        <item name="bottomSheetDialogTheme">@style/AppTheme.BottomSheetDialog</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.Material3.DayNight">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/tv_background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="alertDialogTheme">@style/AppTheme.AlertDialogTheme</item>
        <item name="materialAlertDialogTheme">@style/AppTheme.AlertDialogTheme</item>
        <item name="popupMenuStyle">@style/Widget.Material3.PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/Widget.Material3.PopupMenu.Overflow</item>
        <item name="bottomSheetDialogTheme">@style/AppTheme.BottomSheetDialog</item>
    </style>
</resources>
